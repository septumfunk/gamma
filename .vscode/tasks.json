{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "cmake",
            "command": "configure",
            "preset": "${command:cmake.activeConfigurePresetName}",
        },
        {
            "label": "CMake Build",
            "type": "cmake",
            "command": "build",
            "preset": "${command:cmake.activeConfigurePresetName}",
            "dependsOn": ["CMake Configure"],
        }
    ]
}