{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make debug",
            "type": "shell",
            "command": "make",
            "args": ["CONFIG=debug"],
            "options": {
                "cwd": "${workspaceFolder"
            },
            "problemMatcher": {
                "owner": "gcc",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "make release",
            "type": "shell",
            "command": "make",
            "args": ["CONFIG=release"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "make fresh",
            "type": "shell",
            "command": "make",
            "args": ["fresh"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "make fresh release",
            "type": "shell",
            "command": "make",
            "args": ["fresh", "CONFIG=release"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "copy cwsdpmi",
            "type": "shell",
            "command": "cp",
            "args": ["lib/CWSDPMI.EXE", "bin/release/"]
        },
        {
            "label": "Run DOSBox",
            "type": "shell",
            "command": "dosbox-x",
            "args": [
                "-conf", "${workspaceFolder}/dosbox-x-p2.conf",
                "-c", "mount c \"${workspaceFolder}/bin/release\"",
                "-c", "c:",
                "-c", "gamma"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": ["make release", "copy cwsdpmi"],
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}