{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28
  },

  "configurePresets": [
    {
      "name": "release-desktop",
      "displayName": "Release (Desktop)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug-desktop",
      "displayName": "Debug (Desktop)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release-desktop",
      "configurePreset": "release-desktop"
    },
    {
      "name": "debug-desktop",
      "configurePreset": "debug-desktop"
    }
  ]
}
